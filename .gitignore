.ipynb_checkpoints/
validation_output/
data/structures/*.pdb
data/structures/*.cif

# A reader's own record of what pip resolved on their machine.
# See environment/README.md -- keep it with your results, do not commit it.
environment/resolved.txt

# Local environment and downloaded binaries.
.venv/
.tools/

# environment/README.md's Windows recipe writes this: requirements.txt with the
# vina line filtered out, because that pin has no Windows wheel and its sdist
# build failure aborts the whole install. It is generated, so following the
# documented instructions should not leave anything in `git status`.
requirements-windows.txt

# Chapter outputs are generated. Reference results in outputs/expected/ are not.
ch*/outputs/*
!ch*/outputs/expected/
